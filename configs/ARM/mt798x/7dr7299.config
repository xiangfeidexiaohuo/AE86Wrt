# TP-Link TL-7DR7299 v1, MT7988A + MT7992 闭源 mtwifi 驱动
# 叠加在源码树 defconfig/mt7988_mt7992.config 之上
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic_a73=y
CONFIG_TARGET_mediatek_filogic_a73_DEVICE_tplink_tl-7dr7299-v1=y

# 与已知良好的 TL-7DR7299 编译保持一致的射频前端选择
# Radio 1 使用内部 PA/LNA；Radio 2 使用外部 PA/LNA
CONFIG_MTK_WIFI7_FIRST_IF_IPAILNA=y
# CONFIG_MTK_WIFI7_FIRST_IF_EPAELNA is not set
# CONFIG_MTK_WIFI7_FIRST_IF_IPAELNA is not set
CONFIG_MTK_WIFI7_SECOND_IF_EPAELNA=y
# CONFIG_MTK_WIFI7_SECOND_IF_IPAILNA is not set
# CONFIG_MTK_WIFI7_SECOND_IF_IPAELNA is not set

# Web UI 与中文本地化
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-theme-argon=y

# iStore
CONFIG_PACKAGE_luci-app-store=y

# OpenClash（Meta 核心由 diy/mt798x/7299_2.sh 内嵌）
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_unzip=y

# Tailscale 及其精确匹配的内核依赖
CONFIG_PACKAGE_tailscale=y

# MTK 闭源 Wi-Fi 与硬件加速面板
CONFIG_PACKAGE_luci-app-mtwifi-cfg=y
CONFIG_PACKAGE_luci-i18n-mtwifi-cfg-zh-cn=y
CONFIG_PACKAGE_mtwifi-cfg=y
CONFIG_PACKAGE_luci-app-turboacc-mtk=y
CONFIG_PACKAGE_luci-i18n-turboacc-mtk-zh-cn=y
CONFIG_PACKAGE_kmod-mediatek_hnat=y
CONFIG_PACKAGE_kmod-mtk_wed=y
CONFIG_PACKAGE_kmod-warp=y

# 网页终端
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_ttyd=y

# USB 存储与 Samba 共享
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_autosamba=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-i18n-samba4-zh-cn=y
CONFIG_PACKAGE_samba4-server=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-scsi-core=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_exfat-fsck=y
CONFIG_PACKAGE_ntfs3-mount=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_usbutils=y

# 按主机统计流量
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y

# UPnP / NAT-PMP
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_miniupnpd-nftables=y

# LuCI 文件管理器（由 diy/mt798x/7299_2.sh 从上游 LuCI 添加）
CONFIG_PACKAGE_luci-app-filemanager=y

# 常用维护工具
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_kmod-mtd-rw=y

# 控制镜像体积
# CONFIG_PACKAGE_luci-app-diskman is not set
# CONFIG_PACKAGE_luci-app-dockerman is not set
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-app-daed is not set
# CONFIG_PACKAGE_luci-app-easytier is not set
# CONFIG_PACKAGE_luci-app-openlist2 is not set
# CONFIG_PACKAGE_luci-app-oaf is not set
# CONFIG_PACKAGE_luci-app-zerotier is not set
